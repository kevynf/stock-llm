{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StockLLM",
  "version": "0.1.1",
  "identifier": "com.stockllm.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "StockLLM",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "visible": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/stockllm-backend"],
    "shortDescription": "本地优先的 A 股投资研究助手",
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "StockLLM"
      }
    }
  }
}
